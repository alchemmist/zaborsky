# Доступ к админ-панели (/admin). Задайте эти значения на сервере в файле .env
# Логин и пароль, которые заказчик вводит в окне входа при заходе на /admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
# Секрет для подписи cookie авторизации. Любая длинная случайная строка.
# Сгенерировать: openssl rand -hex 32
ADMIN_SECRET=replace-with-long-random-string
